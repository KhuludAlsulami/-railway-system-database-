<<
/Type /StructElem
/S /H1
/T (SELECT s.DepartureCity, s.ArrivalCity, s.DepartureTime, s.Distance, s.TicketPrice, t.FirstName, t.PhoneNumber, t.Age  FROM Schedule s  JOIN Ticket tk ON s.TripID = tk.TripNumber  JOIN Traveler t ON tk.TravelerName = t.FirstName || ' ' || t.LastName  WHERE s.TripID = 101)
/E (SELECT s.DepartureCity, s.ArrivalCity, s.DepartureTime, s.Distance, s.TicketPrice, t.FirstName, t.PhoneNumber, t.Age  FROM Schedule s  JOIN Ticket tk ON s.TripID = tk.TripNumber  JOIN Traveler t ON tk.TravelerName = t.FirstName || ' ' || t.LastName  WHERE s.TripID = 101)
/Pg 18 0 R
/K [5]
>>
