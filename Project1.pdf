/E (SELECT City, SUM\(TotalTrips\) AS TotalTrips FROM \(     SELECT DepartureCity AS City, COUNT\(*\) AS TotalTrips     FROM Schedule     GROUP BY DepartureCity     UNION ALL     SELECT ArrivalCity AS City, COUNT\(*\) AS TotalTrips     FROM Schedule     GROUP BY ArrivalCity \) AS CityTrips GROUP BY City ORDER BY TotalTrips DESC FETCH FIRST ROW ONLY;)
